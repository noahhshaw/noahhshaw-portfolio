# Daily Baby agent + portfolio site — environment variables
# Copy to .env.local for development; set these in Vercel for production.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=    # from Resend dashboard inbound webhook config

# --- Cache / debounce (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=                # used by reply classifier

# --- Cloudflare R2 (photo storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=daily-bay-baby-photos
R2_PUBLIC_BASE_URL=               # optional; if you set up a custom domain

# --- Optional: QStash (deferred reply processing) ---
QSTASH_TOKEN=                     # if unset, replies are processed by cron sweep only

# --- Auth + cron secrets ---
BABY_SESSION_SECRET=              # 32+ random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BABY_INTERNAL_SECRET=             # for /api/baby/internal/* (routine auth)
CRON_SECRET=                      # optional; if set, cron calls must include Bearer token
NOTIFICATION_EMAIL=noahhshaw@gmail.com
